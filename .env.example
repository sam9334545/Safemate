# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_db_name

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hugging Face Model Identifier
MODEL_ID=umm-maybe/AI-image-detector

# Optional: Custom Hugging Face cache directory
# HF_HOME=/path/to/cache
# TRANSFORMERS_CACHE=/path/to/cache

# Image Screening Security & Size Constraints
MAX_UPLOAD_MB=10
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16000000

# Logging
LOG_LEVEL=INFO

# Optional: Groq Cloud API LLM Layer for Conversational Assistance
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_TIMEOUT_SECONDS=8.0

# Optional: Google Gemini API LLM Layer (Fallback or Standalone)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_TIMEOUT_SECONDS=8.0
