# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# Allowed CORS Origins (comma-separated or JSON list)
# Configure this to match your frontend dev server and deployed frontend origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hugging Face Model Identifier
MODEL_ID=umm-maybe/AI-image-detector

# Optional: Custom Hugging Face cache directory (useful for container/ephemeral environments)
# HF_HOME=/path/to/cache
# TRANSFORMERS_CACHE=/path/to/cache

# Image Screening Security & Size Constraints
MAX_UPLOAD_MB=10
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16000000

# Logging
LOG_LEVEL=INFO
