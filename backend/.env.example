# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_db_name

# JWT Authentication Secrets
SECRET_KEY=your_super_secret_jwt_key_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hugging Face Model Identifier
MODEL_ID=umm-maybe/AI-image-detector

# Image Screening Security & Size Constraints
MAX_UPLOAD_MB=10
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
MAX_IMAGE_PIXELS=16000000

# Logging
LOG_LEVEL=INFO

# Optional Emergency Notification Integrations (Twilio / Webhook)
# If omitted or unconfigured, fallback structured JSON simulation logs are used.
# TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15551234567
# EMERGENCY_WEBHOOK_URL=https://your-webhook-endpoint.org/sos

